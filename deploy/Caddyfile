{
    admin off
    auto_https disable_redirects
}
https://{$SCHOOL_RMM_HOST}:8443 {
    tls internal
    encode gzip
    header -Server
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy app:8000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {remote_host}
        }
    }
}
